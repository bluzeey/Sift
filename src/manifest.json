{
  "manifest_version": 3,
  "name": "Sift",
  "version": "0.1.0",
  "description": "DOM-first, privacy-conscious feed-quality filtering with BYOK classification.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*",
    "https://*.substack.com/*",
    "https://substack.com/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js"
  },
  "action": {
    "default_title": "Sift",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://reddit.com/*",
        "https://*.substack.com/*",
        "https://substack.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
